<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"><encoder><charset>UTF-8</charset><pattern>%level %logger{30} - %msg%n</pattern></encoder></appender>
  <logger name="com.team.cms" level="DEBUG"/>
  <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
