    },
    {
      "id": "003",
      "owner": "郭金滔",
      "purpose": "existing auth seed",
      "status": "existing immutable; not executed by total integration",
      "file": "003-auth-permission-seed.sql"
    }
  ],
  "sessionContract": {
    "implementationOwner": "郭金滔",
    "implemented": "login Session active; CSRF added by YYX R1 for draft creation only",
    "cookie": "JSESSIONID",
    "csrfHeader": "X-CSRF-Token",
    "csrfBootstrap": "GET /api/auth/csrf after login",
    "csrfResponseField": "data (string)",
    "refreshCsrfAfterLogin": true,
    "invalidateOnLogout": true,
    "coverage": "POST /api/items only in R1; registration/login/logout/category/global CSRF coverage remains scheduled auth work"
  },
  "runtimePermissionCompatibility": {
    "canonicalCatalog": "41 planned codes remain stable; constants do not automatically grant permissions",
    "r1ActiveCodes": [
      "article:create",
      "article:edit",
      "category:add",
      "category:view",
      "audit:view"
    ],
    "article:create": "existing EDITOR seed; create own draft only",
    "article:edit": "existing EDITOR seed; read own draft only, not other users or state commands",
    "futureMapping": {
      "item:create": "article:create",
      "item:view:own": "article:edit"
    },
    "migrationPolicy": "Preserve 003 and active permission codes; any future canonical migration needs a new numbered migration and compatible rollout."
  }
}
