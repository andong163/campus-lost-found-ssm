  "authorization": {
    "registrationRole": "EDITOR",
    "implementationOwner": "郭金滔",
    "defaultGrantsImplemented": false,
    "batchPublishAll": [
      "item:batch",
      "item:publish"
    ],
    "batchOfflineAll": [
      "item:batch",
      "item:offline:any"
    ],
    "batchDeleteAll": [
      "item:batch",
      "item:delete:any"
    ],
    "roleDoesNotReplaceOwnershipStateOrContactChecks": true,
    "viewPermissionDoesNotGrantContactAccess": true
  },
  "paging": {
    "pageDefault": 1,
    "sizeDefault": 10,
    "sizeMax": 100,
    "stableTieBreaker": "id"
  },
  "batch": {
    "dto": "BatchIdsRequest",
    "ids": "1..100 distinct positive int64 values",
    "atomic": true,
    "missingOrUnauthorizedOrInvalidState": "whole transaction rolls back"
  },
  "version": {
    "dto": "VersionRequest",
    "field": "version",
    "type": "int32",
    "minimum": 0,
    "requiredOnSingleRecordWrites": true,
    "createValue": "server sets 0",
    "staleResult": 409,
    "mustBeComparedInConditionalUpdate": true
  },
  "time": {
    "formatExample": "2026-10-19T12:00:00",
    "zoneConvention": "Asia/Shanghai local time",
    "storage": "MySQL DATETIME",
    "jsonNumberAllowed": false
  },
  "dtoContracts": {
    "RegisterRequest": {
      "username": "required 4..30 ASCII letters digits underscore",
      "password": "required 8..64 chars; dedicated salted password hash",
      "displayName": "required 2..20 chars; forged role fields ignored; EDITOR only"
    },
    "LoginRequest": {
      "username": "required",
      "password": "required; never logged"
    },
    "CurrentUser": {
      "id": "int64",
      "username": "string",
      "displayName": "string",
      "roles": "set of role codes",
      "permissions": "set of permission codes"
    },
    "CategoryCreateRequest": {
      "name": "required 1..80 chars",
      "parentId": "null root or positive int64",
      "sortOrder": "optional nonnegative int32; default 0"
    },
    "CategoryOption": {
      "id": "int64",
      "name": "string",
      "children": "array of CategoryOption"
    },
    "ItemDraftRequest": {
      "title": "required 2..100 chars",
      "content": "required 10..5000 chars plain text",
      "categoryId": "required positive int64",
      "itemType": "LOST or FOUND string only",
      "eventTime": "required local ISO datetime",
      "location": "required 2..100 chars",
      "contactInfo": "required 2..100 chars private"
    },
    "ItemUpdateRequest": {
      "base": "ItemDraftRequest plus VersionRequest"
    },
    "ReviewDecisionRequest": {
      "version": "required nonnegative int32",
      "decision": "APPROVED or REJECTED",
      "comment": "max 500 chars; nonblank for rejection"
    },
    "ClaimCreateRequest": {
      "claimDescription": "required 1..1000 chars private",
      "contactInfo": "required 1..100 chars private"
    },
    "ClaimReviewRequest": {
      "version": "claim version, required nonnegative int32",
      "decision": "APPROVED or REJECTED",
      "comment": "max 500 chars; reason for rejection"
    },
    "HandoverRequest": {
      "version": "item version, required nonnegative int32",
      "claimId": "required positive int64 for FOUND",
      "claimVersion": "required nonnegative int32 for FOUND"
    },
    "PublicItemSummary": {
      "fields": [
        "id",
        "title",
        "itemType",
        "categoryId",
        "categoryName",
        "eventTime",
        "location",
        "publishedAt",
        "resolutionStatus"
      ]
    },
    "PublicItemDetail": {
      "base": "PublicItemSummary",
      "additionalFields": [
        "content"
      ]
    },
    "PrivateItemDetail": {
      "base": "PublicItemDetail",
      "additionalFields": [
        "authorId",
        "contactInfo",
        "status",
        "version",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreateDraftRequest": {
      "title": "required 2..100 chars",
      "content": "required 10..5000 chars plain text",
      "categoryId": "required positive int64",
      "itemType": "LOST or FOUND string only",
      "eventTime": "required local ISO datetime",
      "location": "required 2..100 chars",
      "contactInfo": "required 2..100 chars private"
    }
  },
  "serverManagedCreateFields": [
    "id",
    "authorId",
    "applicantId",
    "reviewerId",
    "status",
    "resolutionStatus",
    "version",
    "createdAt",
    "updatedAt",
    "publishedAt",
    "resolvedAt",
    "roles",
    "permissions"
  ],
  "neverPublicFields": [
    "password",
    "passwordHash",
    "contactInfo",
    "claimDescription",
    "studentNumber",
    "roleCodes",
    "permissionCodes"
  ],
  "interfaces": {
    "CategoryAccessService": {
      "owner": "孙睿",
      "package": "com.team.cms.category.service",
      "methods": [
        "boolean isBindable(Long categoryId)",
        "void requireBindable(Long categoryId)",
        "List<CategoryOption> publicTree()"
      ],
      "nullIdStatus": 400,
      "missingStatus": 404,
      "disabledAncestorStatus": 409
    },
    "ItemWorkflowService": {
      "owner": "杨程",
      "package": "com.team.cms.review.service",
      "commands": [
        "SUBMIT",
        "WITHDRAW",
        "APPROVE",
        "REJECT",
        "PUBLISH",
        "OFFLINE",
        "EDIT_DRAFT",
        "DELETE",
        "RESOLVE"
      ],
      "commandInput": [
        "itemId from path",
        "version",
        "command-specific validated data"
      ],
      "result": [
        "id",
        "status",
        "resolutionStatus",
        "version"
      ],
      "dependency": "ArticleService -> ItemWorkflowService -> ArticleMapper; never reverse",
      "implemented": false
    },
    "OperationAuditService": {
      "owner": "杨程",
      "safeFields": [
        "operatorId",
        "module",
        "action",
        "targetId",
        "requestId",
        "result",
        "elapsedMs"
      ],
      "forbidden": [
        "requestBody",
        "password",
        "content",
        "contactInfo",
        "claimDescription"
      ],
      "runtimeName": "com.team.cms.audit.service.AuditService / AuditTemplate"
    },
    "CurrentUserContext": {
      "owner": "郭金滔",
      "package": "com.team.cms.auth.security",
      "methods": [
        "static CurrentUser get()",
        "static CurrentUser require()"
      ],
      "unauthenticatedStatus": 401,
      "clientSuppliedActorForbidden": true
    },
    "RequirePermission": {
      "owner": "郭金滔",
      "package": "com.team.cms.auth.security",
      "value": "String",
      "missingPermissionStatus": 403,
      "ADMIN": "existing role bypass",
      "multiplePermissions": "R2 proposal; do not rename or invent a replacement annotation in each module"
    }
  },
